rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isSignedIn()
        && request.auth.token.email == "modelatech2026@gmail.com"
        && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    match /access_requests/{userId} {
      // Owner can read their own request; admin can read/list all.
      allow read: if isOwner(userId) || isSuperAdmin();

      // Owner can create only their own request, and only as PENDING.
      allow create: if isOwner(userId)
        && request.resource.data.uid == userId
        && request.resource.data.status == "PENDING"
        && request.resource.data.role == "PENDING";

      // Owner can update their own doc (e.g. name/photo) but can NOT
      // change status, role or uid (prevents self-approval).
      allow update: if isOwner(userId)
        && !request.resource.data.diff(resource.data).affectedKeys()
             .hasAny(["status", "role", "uid"]);
    }

    // Super admin: full access everywhere (includes delete).
    match /{document=**} {
      allow read, write, delete: if isSuperAdmin();
    }
  }
}
